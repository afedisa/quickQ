#!/bin/sh
# Git pre-push hook to verify formatting and linting

echo "🔍 Verifying code formatting before push..."

# Check if all TypeScript files are formatted
if ! npx prettier --check "apps/**/*.ts" "libs/**/*.ts" 2>&1; then
  echo "❌ Code is not properly formatted!"
  echo "💡 Run 'npm run format' to fix formatting issues"
  exit 1
fi

echo "🔍 Verifying lint rules..."
if ! npx eslint "{apps,libs}/**/*.ts" --max-warnings=0 2>&1; then
  echo "❌ Lint checks failed!"
  echo "💡 Run 'npm run lint' and commit the fixes before pushing"
  exit 1
fi

echo "✅ Formatting and lint checks passed"
exit 0
