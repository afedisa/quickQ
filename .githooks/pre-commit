#!/bin/sh
# Git pre-commit hook to format staged TypeScript files

echo "🔍 Checking code formatting..."

# Get list of staged TypeScript files from apps/libs
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(apps|libs)/.*\.ts$')

if [ -z "$STAGED_FILES" ]; then
  echo "✅ No TypeScript files to format"
  exit 0
fi

# Format staged files
echo "📝 Formatting TypeScript files with Prettier..."
echo "$STAGED_FILES" | xargs npx prettier --write

# Re-add formatted files to staging
echo "$STAGED_FILES" | xargs git add

echo "✅ Code formatted successfully"
exit 0
